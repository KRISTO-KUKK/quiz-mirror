<%- include('partials/header', { title: 'Admin — Pullivara' }) %>

<div class="error-msg" id="error-global"
     style="position:fixed; bottom:20px; right:20px; z-index:200; max-width:300px; background:#fff; padding:12px 16px; border-radius:8px; box-shadow:0 2px 12px rgba(0,0,0,0.15);"></div>

<!-- ══ LOGIN ══ -->
<div id="view-login" style="display:flex; align-items:center; justify-content:center; min-height:100vh;">
  <div style="background:rgba(255,255,255,0.5); border-radius:14px; padding:48px; width:100%; max-width:400px;">
    <div class="logo-block" style="margin-bottom:32px;">
      <img src="/src/logo.png" alt="Pullivara" class="logo-img" />
      <span class="logo-name">ADMIN</span>
    </div>
    <div class="form-group">
      <label>Username</label>
      <input type="text" id="admin-username" placeholder="" />
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="admin-password" placeholder="" />
    </div>
    <div class="error-msg" id="error-login"></div>
    <button class="btn-gold" style="width:100%; margin-top:8px;" onclick="adminLogin()">Login</button>
  </div>
</div>

<!-- ══ DASHBOARD ══ -->
<div id="view-dashboard" style="display:none; padding:60px 80px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:40px;">
    <div class="logo-block">
      <span class="logo-name">PULLIVARA ADMIN</span>
    </div>
    <button class="btn-outline" onclick="logout()">Logout</button>
  </div>

  <!-- Statistika -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-number" id="stat-started">—</div>
      <div>Started</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="stat-completed">—</div>
      <div>Completed</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="stat-abandoned">—</div>
      <div>Abandoned</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="stat-rate">—</div>
      <div>Completion rate</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="stat-dropoff">—</div>
      <div>Avg dropoff question</div>
    </div>
  </div>

  <!-- Logi tabel -->
  <table class="log-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Name</th>
        <th>Email</th>
        <th>Started</th>
        <th>Completed</th>
        <th>Status</th>
        <th>Question</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody id="log-tbody">
      <tr><td colspan="8" style="text-align:center; color:#aaa; padding:40px;">Loading...</td></tr>
    </tbody>
  </table>
</div>

<script src="/script/nav.js"></script>
<script src="/script/api.js"></script>
<script src="/script/admin-ui.js"></script>
</body>
</html>
