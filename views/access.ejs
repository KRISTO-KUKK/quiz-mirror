<%- include('partials/header', { title: 'Request Access — Pullivara' }) %>

<div class="screen active" id="screen-access">
  <div style="padding: 32px 60px; display:flex; align-items:center; gap:12px; border-bottom: 1px solid #ccc;">
    <svg class="logo-svg" style="width:40px" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="100" cy="76" r="20" fill="#1a1a2e"/>
      <path d="M40 75 C20 65 8 50 14 35 C20 20 40 18 55 28" stroke="#b89a2a" stroke-width="10" stroke-linecap="round" fill="none"/>
      <path d="M160 75 C180 65 192 50 186 35 C180 20 160 18 145 28" stroke="#b89a2a" stroke-width="10" stroke-linecap="round" fill="none"/>
    </svg>
    <span style="font-weight:800; letter-spacing:3px; font-size:14px; color:#1a1a2e;">PULLIVARA</span>
  </div>

  <div class="access-container" style="margin: auto;">
    <div class="access-form">
      <h2>Request Quiz Access</h2>
      <div class="form-group">
        <label>First name</label>
        <input type="text" id="input-name" placeholder="" />
      </div>
      <div class="form-group">
        <label>Your email</label>
        <input type="email" id="input-email" placeholder="" />
        <div class="form-hint">Get access code via email</div>
      </div>
      <button class="btn-gold" onclick="sendCode()">Send code</button>
      <div class="error-msg" id="error-access"></div>
    </div>

    <div class="access-logo">
      <div class="logo-block">
        <svg class="logo-svg" viewBox="0 0 200 160" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="100" cy="72" rx="28" ry="36" fill="#1a1a2e"/>
          <path d="M40 75 C20 65 8 50 14 35 C20 20 40 18 55 28" stroke="#b89a2a" stroke-width="8" stroke-linecap="round" fill="none"/>
          <path d="M160 75 C180 65 192 50 186 35 C180 20 160 18 145 28" stroke="#b89a2a" stroke-width="8" stroke-linecap="round" fill="none"/>
          <path d="M40 75 C25 82 14 95 20 108 C26 121 44 120 55 112" stroke="#b89a2a" stroke-width="6" stroke-linecap="round" fill="none"/>
          <path d="M160 75 C175 82 186 95 180 108 C174 121 156 120 145 112" stroke="#b89a2a" stroke-width="6" stroke-linecap="round" fill="none"/>
          <ellipse cx="100" cy="56" rx="14" ry="10" fill="#b89a2a" opacity="0.7"/>
          <path d="M86 56 Q100 40 114 56" fill="#1a1a2e"/>
          <circle cx="100" cy="76" r="20" fill="#1a1a2e"/>
          <text x="100" y="145" text-anchor="middle" font-family="Arial" font-weight="800" font-size="18" letter-spacing="5" fill="#1a1a2e">PULLIVARA</text>
        </svg>
      </div>
    </div>
  </div>
</div>

<!-- ══ MODAL: EMAIL CONFIRMATION ══ -->
<div id="modal-email" class="modal-overlay">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">×</button>
    <h3>We've sent the code to your email!</h3>
    <p>Check your spam folder as well</p>
    <div id="dev-code-hint" style="font-size:12px; color:#b89a2a; margin-bottom:12px;"></div>
    <input type="text" id="input-code" placeholder="Access code" />
    <div class="error-msg" id="error-modal"></div>
    <button class="btn-dark" onclick="enterCode()">Enter</button>
  </div>
</div>

<script src="/script/nav.js"></script>
<script src="/script/api.js"></script>
<script src="/script/auth.js"></script>
</body>
</html>
