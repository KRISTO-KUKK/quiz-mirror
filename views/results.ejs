<%- include('partials/header', { title: 'Your Results — Pullivara' }) %>

<div id="screen-results" class="screen active">
  <div class="results-container">

    <p class="results-header">Your Career Clarity Snapshot</p>

    <h1 class="results-headline">
      You're in the <span id="res-stage"></span> phase of your career journey,
      showing up as a <span id="res-archetype"></span>.
    </h1>

    <p class="results-mirror">It's not just a label — it's a mirror reflecting your moment, your energy, and what's possible next.</p>

    <div class="results-archetype" id="res-text"></div>

    <div class="results-insights">
      <h4 class="results-insights-title">Key Insights</h4>
      <div class="results-insights-grid">
        <div class="results-insight-item">
          <span class="insight-label">You might be feeling</span>
          <span class="insight-value" id="res-feeling"></span>
        </div>
        <div class="results-insight-item">
          <span class="insight-label">You'll thrive in</span>
          <span class="insight-value" id="res-thrive"></span>
        </div>
        <div class="results-insight-item">
          <span class="insight-label">What's possible now</span>
          <span class="insight-value" id="res-possible"></span>
        </div>
      </div>
    </div>

    <div class="results-possible">
      <h4 class="results-possible-title">What Becomes Possible</h4>
      <div class="results-possible-grid">
        <div class="results-possible-item">
          <span class="possible-label">Right Now</span>
          <span class="possible-value" id="res-right-now"></span>
        </div>
        <div class="results-possible-item">
          <span class="possible-label">Next 90 Days</span>
          <span class="possible-value" id="res-next90"></span>
        </div>
      </div>
    </div>

    <div class="results-nextstep">
      <h4 class="results-nextstep-title">Your Next Step — Tailored to You</h4>
      <p class="results-nextstep-text" id="res-recommendation"></p>
      <button class="btn-gold" onclick="downloadResults()">Download Full Report</button>
    </div>

    <p class="results-copyright">This result is for personal use only. It is copyrighted content and may not be copied, shared, or redistributed without written permission from Pullivara Group.</p>

  </div>
</div>

<script src="/script/results-data.js"></script>
<script>
  (function () {
    const stage     = sessionStorage.getItem('resultStage')     || '';
    const archetype = sessionStorage.getItem('resultArchetype') || '';
    const name      = sessionStorage.getItem('userName')        || '';

    if (!stage) {
      window.location.href = '/';
      return;
    }

    const key  = `${stage}_${archetype}`;
    const data = RESULT_DATA[key] || {};

    document.getElementById('res-stage').textContent          = stage;
    document.getElementById('res-archetype').textContent      = archetype;
    document.getElementById('res-text').innerHTML             = (data.description || '').replace(/\n/g, '<br><br>');
    document.getElementById('res-feeling').textContent        = data.feeling        || '';
    document.getElementById('res-thrive').textContent         = data.thrive         || '';
    document.getElementById('res-possible').textContent       = data.possible       || '';
    document.getElementById('res-right-now').textContent      = data.rightNow       || '';
    document.getElementById('res-next90').textContent         = data.next90         || '';
    document.getElementById('res-recommendation').textContent = data.recommendation || '';

    window.downloadResults = function () {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      script.onload = function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'landscape' });

        const pageW = 297;
        const pageH = 210;
        const cx = pageW / 2;
        const margin = 25;
        const contentW = pageW - margin * 2;
        let y = 28;

        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(2);
        doc.rect(10, 10, pageW - 20, pageH - 20);
        doc.setLineWidth(0.5);
        doc.rect(13, 13, pageW - 26, pageH - 26);

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(15);
        doc.setTextColor(184, 154, 42);
        doc.text('PULLIVARA', cx, y, { align: 'center' });
        y += 8;

        doc.setFontSize(22);
        doc.setTextColor(26, 26, 46);
        doc.text('Career Clarity Snapshot', cx, y, { align: 'center' });
        y += 20;

        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(0.5);
        doc.line(cx - 40, y, cx + 40, y);
        y += 10;

        if (name) {
          doc.setFont('helvetica', 'italic');
          doc.setFontSize(13);
          doc.setTextColor(100, 100, 100);
          doc.text('Prepared for', cx, y, { align: 'center' });
          y += 8;
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(18);
          doc.setTextColor(26, 26, 46);
          doc.text(name, cx, y, { align: 'center' });
          y += 10;
        }

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(100, 100, 100);
        doc.text('Career Stage', cx, y, { align: 'center' });
        y += 6;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(184, 154, 42);
        doc.text(stage, cx, y, { align: 'center' });
        y += 9;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(100, 100, 100);
        doc.text('Career Persona', cx, y, { align: 'center' });
        y += 6;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(184, 154, 42);
        doc.text(archetype, cx, y, { align: 'center' });
        y += 10;

        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(0.5);
        doc.line(cx - 40, y, cx + 40, y);
        y += 8;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(15);
        doc.setTextColor(60, 60, 60);
        const paragraphs = (data.description || '').split('\n').filter(p => p.trim());
        paragraphs.forEach(para => {
          const lines = doc.splitTextToSize(para, contentW);
          lines.forEach(line => {
            if (y > pageH - 20) return;
            doc.text(line, cx, y, { align: 'center' });
            y += 5.5;
          });
          y += 3;
        });

        doc.setFont('helvetica', 'italic');
        doc.setFontSize(8);
        doc.setTextColor(180, 180, 180);
        doc.text('Generated by Pullivara Career Clarity Tool', cx, pageH - 17, { align: 'center' });

        doc.save('career-clarity-snapshot.pdf');
      };
      document.head.appendChild(script);
    };
  })();
</script>

</body>
</html>
