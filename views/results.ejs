<%- include('partials/header', { title: 'Your Results — Pullivara' }) %>

<div id="screen-results" class="screen active">
  <p class="results-header">Your Career Clarity Snapshot</p>

  <p class="results-intro">
    You're in the <strong id="res-stage"></strong> phase of your career journey,
    showing up as a <strong id="res-archetype"></strong>.
  </p>

  <div class="results-archetype" id="res-text"></div>

  <div class="results-cta">
    <h3>Download Your Full Career Clarity Report + Purpose Path Workbook, your personalised roadmap to navigate out of this phase.</h3>
    <p>You'll find deeper insights, opportunities, and next steps in your full report.</p>
    <p>The Pullivara Purpose Path Workbook is your strategy companion built to help you map out a clear, aligned, and actionable next chapter. Inside your full report, you'll also find:</p>
    <ul>
      <li>Work environments that match your current energy</li>
      <li>Suggested role types and industries that fit your profile</li>
      <li>Real-world examples to inspire your next move</li>
    </ul>
    <button class="btn-gold" onclick="downloadResults()">Download</button>
  </div>
</div>

<script>
  (function () {
    const stage       = sessionStorage.getItem('resultStage')       || '';
    const archetype   = sessionStorage.getItem('resultArchetype')   || '';
    const description = sessionStorage.getItem('resultDescription') || '';
    const name        = sessionStorage.getItem('userName')          || '';

    if (!stage) {
      window.location.href = '/';
      return;
    }

    document.getElementById('res-stage').textContent     = stage;
    document.getElementById('res-archetype').textContent = archetype;
    document.getElementById('res-text').innerHTML        = description.replace(/\n/g, '<br><br>');

    window.downloadResults = function () {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
      script.onload = function () {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'landscape' });

        const pageW = 297;
        const pageH = 210;
        const cx = pageW / 2;
        const margin = 25;
        const contentW = pageW - margin * 2;
        let y = 28;

        // Outer border
        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(2);
        doc.rect(10, 10, pageW - 20, pageH - 20);
        doc.setLineWidth(0.5);
        doc.rect(13, 13, pageW - 26, pageH - 26);

        // Title
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(15);
        doc.setTextColor(184, 154, 42);
        doc.text('PULLIVARA', cx, y, { align: 'center' });
        y += 8;

        doc.setFontSize(22);
        doc.setTextColor(26, 26, 46);
        doc.text('Career Clarity Snapshot', cx, y, { align: 'center' });
        y += 20;

        // Gold divider
        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(0.5);
        doc.line(cx - 40, y, cx + 40, y);
        y += 10;

        // Name
        if (name) {
          doc.setFont('helvetica', 'italic');
          doc.setFontSize(13);
          doc.setTextColor(100, 100, 100);
          doc.text('Prepared for', cx, y, { align: 'center' });
          y += 8;
          doc.setFont('helvetica', 'bold');
          doc.setFontSize(18);
          doc.setTextColor(26, 26, 46);
          doc.text(name, cx, y, { align: 'center' });
          y += 10;
        }

        // Stage & Archetype
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(100, 100, 100);
        doc.text('Career Stage', cx, y, { align: 'center' });
        y += 6;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(184, 154, 42);
        doc.text(stage, cx, y, { align: 'center' });
        y += 9;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(11);
        doc.setTextColor(100, 100, 100);
        doc.text('Career Persona', cx, y, { align: 'center' });
        y += 6;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(14);
        doc.setTextColor(184, 154, 42);
        doc.text(archetype, cx, y, { align: 'center' });
        y += 10;

        // Gold divider
        doc.setDrawColor(184, 154, 42);
        doc.setLineWidth(0.5);
        doc.line(cx - 40, y, cx + 40, y);
        y += 8;

        // Description (centered, wrapped)
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(15);
        doc.setTextColor(60, 60, 60);
        const paragraphs = description.split('\n').filter(p => p.trim());
        paragraphs.forEach(para => {
          const lines = doc.splitTextToSize(para, contentW);
          lines.forEach(line => {
            if (y > pageH - 20) return;
            doc.text(line, cx, y, { align: 'center' });
            y += 5.5;
          });
          y += 3;
        });

        // Footer
        doc.setFont('helvetica', 'italic');
        doc.setFontSize(8);
        doc.setTextColor(180, 180, 180);
        doc.text('Generated by Pullivara Career Clarity Tool', cx, pageH - 17, { align: 'center' });

        doc.save('career-clarity-snapshot.pdf');
      };
      document.head.appendChild(script);
    };
  })();
</script>

</body>
</html>
